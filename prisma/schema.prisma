generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  SUPPORT
  USER
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  roles            UserRole[]
  isActive         Boolean   @default(true)
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
